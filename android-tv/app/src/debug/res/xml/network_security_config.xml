<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app reach the Firebase emulators over plain HTTP on the dev
     machine (10.0.2.2 from an Android emulator, localhost through `adb reverse`, or a LAN IP). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>

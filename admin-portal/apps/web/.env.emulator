# `vite --mode emulator` (pnpm dev:emulator): the Auth emulator with the demo project.
# demo- project ids only exist in the emulator. Nothing here is secret.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-qms.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-qms
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

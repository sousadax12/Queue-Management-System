# Copy to .env.local for `pnpm dev`. In the container, set the same names as env vars
# (they are read at start, so one image serves any project and domain).
# Web config of the Firebase project (Firebase console > Project settings > Your apps > Web).
# None of these are secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Public origin of the portal, e.g. https://admin.example.com. Verification and password-reset
# emails link back here. Defaults to the page's origin. Its domain must be listed under
# Authentication > Settings > Authorized domains.
VITE_PUBLIC_BASE_URL=

# Local development against the Auth emulator: `pnpm --filter @qms/web dev:emulator` uses
# .env.emulator, which sets:
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-qms.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-qms
# VITE_FIREBASE_APP_ID=demo-app
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

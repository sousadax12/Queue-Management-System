{
  "name": "@qms/web",
  "version": "0.1.0",
  "private": true,
  "description": "The web admin portal: Vite + React SPA with Firebase Auth, served as static files.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "firebase --config ../../firebase.json emulators:exec --only auth --project demo-qms \"vite --mode emulator\"",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:emulator": "firebase --config ../../firebase.json emulators:exec --only auth --project demo-qms \"vitest run --config vitest.emulator.config.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@qms/contract": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
